{
  "name": "my-claudia",
  "version": "0.1.1220",
  "private": true,
  "description": "A cross-platform UI for Code CLI (Claude Code / Cursor / Codex)",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/with-project-node.sh pnpm -r --parallel run dev",
    "start:clean": "bash scripts/dev/start-app-clean.sh",
    "build": "bash scripts/with-project-node.sh pnpm -r run build",
    "server:dev": "bash scripts/with-project-node.sh pnpm --filter @my-claudia/server run dev",
    "server:dev:isolated": "bash scripts/with-project-node.sh env PORT=0 MY_CLAUDIA_DATA_DIR=$HOME/.my-claudia-dev pnpm --filter @my-claudia/server run dev",
    "gateway:dev": "bash scripts/with-project-node.sh pnpm --filter @my-claudia/gateway run dev",
    "desktop:dev": "bash scripts/with-project-node.sh pnpm --filter @my-claudia/desktop run dev",
    "build:macos": "bash scripts/build/macos.sh",
    "build:macos:install": "bash scripts/build/install-macos.sh",
    "release:macos": "bash scripts/release/macos.sh",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "check:architecture": "bash scripts/with-project-node.sh node scripts/check-architecture-boundaries.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "test": "bash scripts/with-project-node.sh pnpm -r run test",
    "test:unit": "bash scripts/with-project-node.sh pnpm -r run test",
    "test:e2e": "bash scripts/with-project-node.sh vitest run --config e2e/vitest.config.e2e.ts",
    "test:e2e:ui": "bash scripts/with-project-node.sh vitest --config e2e/vitest.config.e2e.ts --ui",
    "test:e2e:workflows": "bash scripts/with-project-node.sh vitest run --config e2e/vitest.config.e2e.ts e2e/tests/user-workflows.spec.ts",
    "test:e2e:performance": "bash scripts/with-project-node.sh vitest run --config e2e/vitest.config.e2e.ts e2e/tests/performance.spec.ts",
    "test:e2e:local": "bash scripts/with-project-node.sh env TEST_MODES=local vitest run --config e2e/vitest.config.e2e.ts",
    "test:e2e:remote": "bash scripts/with-project-node.sh env TEST_MODES=remote vitest run --config e2e/vitest.config.e2e.ts",
    "test:e2e:gateway": "bash scripts/with-project-node.sh env TEST_MODES=gateway vitest run --config e2e/vitest.config.e2e.ts",
    "test:e2e:modes": "bash scripts/with-project-node.sh vitest run --config e2e/vitest.config.e2e.ts e2e/tests/connection/",
    "test:e2e:shared": "bash scripts/with-project-node.sh vitest run --config e2e/vitest.config.e2e.ts e2e/tests/shared/",
    "test:e2e:playwright": "bash scripts/with-project-node.sh playwright test",
    "test:e2e:playwright:ui": "bash scripts/with-project-node.sh playwright test --ui",
    "test:e2e:playwright:debug": "bash scripts/with-project-node.sh playwright test --debug",
    "test:e2e:playwright:codegen": "bash scripts/with-project-node.sh playwright codegen http://localhost:1420",
    "test:e2e:playwright:report": "bash scripts/with-project-node.sh playwright show-report",
    "fixtures:generate": "bash scripts/with-project-node.sh node e2e/fixtures/performance-data/generate-fixtures.js",
    "test:desktop": "bash scripts/with-project-node.sh pnpm --filter @my-claudia/desktop run test",
    "test:server": "bash scripts/with-project-node.sh pnpm --filter @my-claudia/server run test",
    "test:cli-review-jobs": "bash scripts/with-project-node.sh pnpm --filter @my-claudia/server run test:cli-review-jobs",
    "test:ai-review-hardening": "bash scripts/diagnostics/verify-ai-review-hardening.sh",
    "test:file": "bash scripts/with-project-node.sh node scripts/test-file-by-file.mjs",
    "test:stores": "bash scripts/with-project-node.sh node scripts/test-file-by-file.mjs \"apps/desktop/src/stores\"",
    "test:services": "bash scripts/with-project-node.sh node scripts/test-file-by-file.mjs \"apps/desktop/src/services\"",
    "test:components": "bash scripts/with-project-node.sh node scripts/test-file-by-file.mjs \"apps/desktop/src/components\"",
    "test:utils": "bash scripts/with-project-node.sh node scripts/test-file-by-file.mjs \"apps/desktop/src/utils\"",
    "preinstall": "node scripts/ensure-node-version.mjs",
    "postinstall": "node scripts/check-native-modules.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@browserbasehq/stagehand": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "openai": "^6.34.0",
    "playwright-core": "^1.58.1",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.4.2",
    "sharp": "^0.34.5",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  }
}
